# Aplicacao
NODE_ENV=production
APP_HOST=127.0.0.1
APP_PORT=4318
NEXT_PUBLIC_SITE_URL=https://indicacoes.exemplo.com

# Banco MySQL que armazena as indicacoes e os tokens OAuth
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Integracao RD Station CRM V2
RD_CLIENT_ID=
RD_CLIENT_SECRET=
RD_OAUTH_TOKEN_URL=https://api.rd.services/oauth2/token

# Token da API V1, usado para manter as opcoes do campo de consultor
RD_CRM_V1_TOKEN=

# IDs do RD Station CRM (não são credenciais, mas variam por conta)
RD_CAMPO_PARCEIRO_EMPRESA=
RD_CAMPO_CONSULTOR_NEGOCIACAO=
RD_CAMPO_DOCUMENTO_CLIENTE=
RD_CAMPO_PRE_VENDEDOR_B2B=
RD_OPCAO_PRE_VENDEDOR_B2B=
RD_CAMPO_QUANTIDADE_CLIENTES=
RD_CAMPO_CURVA_PARCEIRO=
RD_CAMPO_SETOR_PARCEIRO=
RD_CAMPO_DOCUMENTO_PARCEIRO=
RD_ETAPA_INDICACAO=
RD_EQUIPE_INDICACAO=
RD_CAMPANHA_INDICACAO=
RD_FUNIL_AGENDAMENTO=
RD_ETAPA_AGENDAMENTO=
RD_EQUIPE_CLOSER=
RD_CAMPANHA_AGENDAMENTO=

# Google Agenda - conta de serviço com delegação em todo o domínio
# Mantenha o JSON fora da pasta public e não envie a chave ao repositório.
GOOGLE_SERVICE_ACCOUNT_FILE=credenciais/google-service-account.json
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
