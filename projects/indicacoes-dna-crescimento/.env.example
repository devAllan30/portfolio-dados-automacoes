# Execução da aplicação atrás do Nginx.
NODE_ENV=production
APP_HOST=127.0.0.1
APP_PORT=4320

# Token pessoal da API v1 do RD Station CRM.
RD_STATION_TOKEN=

# OAuth da API V2 do RD Station. Os tokens renováveis são lidos de
# rd_st_qc.rd_oauth_tokens; estas credenciais são usadas apenas na renovação.
RD_CLIENT_ID=
RD_CLIENT_SECRET=
RD_OAUTH_TOKEN_URL=https://api.rd.services/oauth2/token

# RD Station CRM V2 - formulário SST / indicação de cliente (B2C).
# Os IDs abaixo já correspondem à configuração atual e podem ser substituídos por ambiente.
RD_B2C_CONSULTANT_FIELD_ID=679294da974d290014ec0261
RD_B2C_DOCUMENT_FIELD_ID=68acc240a65baa0017cc3700
RD_B2C_STAGE_ID=678fb2c4ec27e8001e9926a7
RD_B2C_TEAM_ID=67a10d03a007d8001879c16b
RD_B2C_CAMPAIGN_ID=6866ad7eda2694001ef59e3a

# Banco MySQL das indicações da Imersão DNA Crescimento.
MYSQL_HOST=35.170.84.61
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_IMERSAO_DATABASE=imersao_qc

# Endereço base usado para gerar os links individuais dos consultores.
INDICATION_BASE_URL=https://indicacoes.napraticaclub.com.br

# Conta de serviço Google com delegação para as agendas da equipe CLOSER SST.
# Em produção, use o caminho do JSON no servidor ou GOOGLE_SERVICE_ACCOUNT_JSON_BASE64.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
