# RD Station CRM
RD_CRM_TOKEN=preencha_o_token
RD_PIPELINE_IDS=id_funil_1,id_funil_2

# Associa cada campo canônico ao ID, api_identifier ou nome do campo no RD.
# Mantenha em uma única linha no arquivo .env real.
RD_FIELD_MAP_JSON={"payer_name":"id_campo_nome_pagador","payer_document":"id_campo_cpf_cnpj","payer_email":"id_campo_email","payer_phone":"id_campo_telefone","billing_street":"id_campo_rua","billing_number":"id_campo_numero","billing_district":"id_campo_bairro","billing_city":"id_campo_cidade","billing_state":"id_campo_estado","billing_zip":"id_campo_cep","payment_method":"id_campo_forma_pagamento","installments":"id_campo_parcelas","partner_discount":"id_campo_abatimento","notes":"id_campo_observacoes"}

# Omie
OMIE_APP_KEY=preencha_a_app_key
OMIE_APP_SECRET=preencha_a_app_secret
OMIE_OS_STAGE=10
OMIE_SERVICE_CITY=CIDADE (UF)
OMIE_PAYMENT_TERM=999
OMIE_DEFAULT_CATEGORY=1.01.01

# Mapeamento dos produtos do RD para código de serviço e categoria do Omie.
OMIE_PRODUCT_MAP_JSON={"Produto demonstrativo":{"service_code":1234567890,"category":"1.01.01"}}

# Palavras-chave da forma de pagamento para a conta corrente do Omie.
OMIE_PAYMENT_ACCOUNT_MAP_JSON={"pix":1234567890,"boleto":1234567890,"credito":1234567891,"cartao":1234567891}

# Persistência, limites e rede
RD_OMIE_DATA_DIR=./runtime
HTTP_TIMEOUT=30
OMIE_MIN_INTERVAL_SECONDS=3.5
OMIE_MAX_RETRIES=3

# Relatório por e-mail
EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario@example.com
SMTP_PASSWORD=senha_ou_app_password
SMTP_FROM=automacao@example.com
SMTP_TO=destinatario@example.com
SMTP_CC=
SMTP_BCC=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
